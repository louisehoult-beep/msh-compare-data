{
  "_about": {
    "what": "Per-speciality relevance rules for the KEYWORD SLICE of scripts/build_speciality_news.py: general trade-press items (sources listed in generalSources) that are routed to a speciality page only when their headline matches that speciality's rule. Approved by Lou 29/09/2026 for every speciality.",
    "keys": "Rules are keyed by speciality PAGE slug (data/speciality-panels/<slug>.json, data/speciality-news/<slug>.json). data/speciality-map.json and data/speciality-label-map.json use the separate Compare product-category slugs (continence, wound, handling...), which are not page slugs and are deliberately not keys here.",
    "matching": "Each pattern is a Python regex, wrapped by the script in (?<![\\w-])(...)(?![\\w-]) so it only ever matches whole words. Case-insensitive; a pattern that must be case-sensitive (MS, PAD, GPs) uses a scoped (?-i:...) group. A match in the HEADLINE is required; the summary is only used by exclude patterns, never to include. Tested 29/09/2026: summary-only matching let in items whose summary name-checked a condition in passing.",
    "deny": "denyTitle is checked first, for every speciality: routine publications (events, awards, quizzes, sponsored content, people moves, fitness-to-practise cases, first-person columns, clinical-education explainers). Category alone is not relevance: the Sales Triggers Desk's first version published a privacy notice and a careers fair. Do not loosen a rule to fill an empty page; an empty list is the honest outcome.",
    "tests": "test_speciality_news_keywords.py asserts every page slug has a rule, every pattern compiles, and a fixture of real 29/09/2026 headlines routes (and does not route) as judged by hand."
  },
  "noRule": {
    "capital-estates-watch": "Not a clinical speciality, and not a speciality in hub/my-hub-catalogue.json, so a news file for it fails test_my_hub_catalogue (a news file must be pinnable). Its only match in 60 days of Pulse and Nursing in Practice (29/09/2026) was one GP premises-funding story. Add a rule here AND a catalogue entry together if Lou wants it."
  },
  "generalSources": ["pulse_today", "nursing_in_practice", "pnur_toc", "nrec_toc", "bjon_toc"],
  "denyTitle": [
    "(?:register|sign up|book) (?:for|now)", "last chance", "webinars?", "podcasts?", "events?", "awards?", "shortlist\\w*",
    "Pulse LIVE", "Nursing in Practice (?:Scotland|North|Virtual|Podcast)",
    "quiz\\w*", "crossword", "sponsored", "advertorial", "partner content",
    "appoint(?:s|ed)", "re-elected", "elected", "to retire", "retires", "obituar\\w*",
    "struck off", "fitness to practise", "FtP", "unfair dismissal", "tribunal", "suspend(?:s|ed)?", "sexual(?:ly)? (?:assault\\w*|misconduct)", "misconduct",
    "job adverts?", "vacanc(?:y|ies)", "careers? (?:fair|event|day)s?", "recruitment (?:fair|event|day)s?",
    "privacy (?:notice|policy)", "cookies?", "terms and conditions", "corrections?", "erratum", "retraction", "letters? to the editor", "editorial", "membership",
    "news watch", "round-?up",
    "myths?(?: and facts)?", "what (?:nurses|GPs|practice nurses|primary care nurses) need to know",
    "key questions on", "quick cases", "clinical casebook", "case by case", "top ten advice and guidance",
    "how to (?:spot|diagnose|manage|recognise|advise)", "when to (?:suspect|reassure|investigate|refer)", "interviews?", "can you (?:diagnose|spot|identify)", "what(?:'|’)?s the cause of", "why should I"
  ],
  "denyTitleWhole": [
    "^[‘'\"“].*[’'\"”]$",
    "^News$",
    "^.+; and (?:why|when|how|what|should) "
  ],
  "rules": {
    "audiology-and-hearing": {"include": ["audiolog\\w*", "hearing (?:loss|aids?|tests?|services?|impair\\w*)", "tinnitus", "cochlear", "deaf(?:ness)?"]},
    "cardiology-and-cardiac-surgery": {"include": ["cardiolog\\w*", "cardiac", "cardiovascular", "heart (?:failure|attack|disease|conditions?|rhythm|valve|surgery)", "atrial fibrillation", "hypertension", "blood pressure", "cholesterol", "statins?", "angina", "arrhythmi\\w*", "(?-i:CVD)"]},
    "colorectal-gi-and-endoscopy": {"include": ["gastroenterolog\\w*", "colorectal", "bowel (?:cancer|screening)", "endoscop\\w*", "colonoscop\\w*", "(?-i:IBD)", "Crohn(?:'s|’s)?", "ulcerative colitis", "coeliac", "hepatitis", "liver (?:disease|cancer|failure)", "cirrhosis", "anterior resection", "pancreatitis"]},
    "continence-bladder-and-bowel": {"include": ["continence", "incontinence", "overactive bladder", "urinary catheter\\w*", "catheter-associated", "rectal catheters?", "stomas?", "stoma care", "ostom\\w*", "bowel management", "lower urinary tract symptoms", "(?-i:LUTS)", "urinary tract infections?", "(?-i:UTIs?)", "bladder damage"]},
    "critical-care": {"include": ["intensive care", "(?-i:ICU)", "critical care", "ventilat(?:or|ors|ion)", "(?-i:ECMO)"],
      "exclude": ["babies", "baby", "newborns?", "neonatal", "infants?"]},
    "dermatology": {"include": ["dermatolog\\w*", "eczema", "psoriasis", "acne", "skin cancers?", "melanoma", "dermatitis", "urticaria", "skin conditions?", "sunscreen"]},
    "diabetes-and-endocrinology": {"include": ["diabet\\w*", "insulin", "(?-i:SGLT-?2s?)", "(?-i:HbA1c)", "glucose", "thyroid", "endocrin\\w*"]},
    "digital-and-medical-it": {"include": ["(?-i:AI)", "artificial intelligence", "AI-(?:generated|powered)", "digital", "NHS App", "electronic (?:patient|health) records?", "(?-i:EPR)", "IT (?:outage|glitch|system)s?", "cyber\\w*", "Palantir", "federated data platform", "single patient record", "data sharing"]},
    "emergency-and-urgent-care": {"include": ["A&E", "emergency departments?", "urgent (?:and emergency )?care", "ambulances?", "NHS 111", "walk-in (?:centres?|clinics?)", "paramedic\\w*", "mass casualty"]},
    "ent-and-head-and-neck": {"include": ["(?-i:ENT)", "ear, nose and throat", "otitis(?: media)?", "tonsil\\w*", "sinusitis", "head and neck cancers?", "laryn\\w*"]},
    "frailty-and-older-people": {"include": ["frailty", "frail", "older (?:people|patients|adults)(?:(?:'|’)s)?", "elderly", "care homes?", "falls (?:prevention|risk|clinics?|services?)", "(?:risk of|prevent\\w*|reduc\\w*) falls", "dementia", "delirium", "geriatric\\w*"],
      "exclude": ["nurse prescribers?"]},
    "gynaecology-and-womens-health": {"include": ["gynaecolog\\w*", "endometriosis", "menopaus\\w*", "(?-i:HRT)", "fibroids", "cervical (?:screening|cancer|smear)", "(?-i:HPV)", "womb cancer", "ovarian", "contracepti\\w*", "(?-i:IUDs?)", "pelvic pain", "(?-i:PCOS)", "polycystic ovary", "women(?:'|’)s health"]},
    "haematology-and-patient-blood-management": {"include": ["haematolog\\w*", "anaemia", "(?:blood )?transfusions?", "sickle cell", "thalassaemia", "leukaemia", "lymphoma", "myeloma", "iron deficiency", "B12 deficiency", "blood donat\\w*"],
      "exclude": ["infected blood"]},
    "infection-prevention-and-control": {"include": ["infection prevention", "infection control", "(?-i:IPC)", "hospital-acquired", "healthcare-associated", "(?-i:HCAIs?)", "(?-i:MRSA)", "C\\. difficile", "Clostridioides", "carbapenem\\w*", "norovirus", "hand hygiene", "(?-i:PPE)", "antimicrobial resistance", "(?-i:AMR)", "decontamination", "sterilis\\w*", "disinfect\\w*"]},
    "interventional-radiology": {"include": ["interventional radiolog\\w*", "thrombectomy", "embolisation", "angioplasty", "stents?"]},
    "maternity-and-neonatal": {"include": ["maternity", "midwi\\w*", "neonatal", "newborns?", "pregnan\\w*", "antenatal", "postnatal", "stillbirths?", "gestational", "(?:babies|baby) in intensive care", "maternal"]},
    "mental-health": {"include": ["mental health", "(?-i:ADHD)", "autism", "autistic", "depression", "antidepressants?", "(?-i:OCD)", "psychos[ie]s", "schizophreni\\w*", "bipolar", "eating disorders?", "suicid\\w*", "self-harm", "psychiatr\\w*"]},
    "neurology-and-neurosurgery": {"include": ["neurolog\\w*", "neurosurg\\w*", "epilep\\w*", "seizures?", "multiple sclerosis", "people with (?-i:MS)", "Parkinson(?:'s|’s)?", "motor neurone", "migraines?", "hydrocephalus", "brain tumours?", "dementia"]},
    "nutrition-and-dietetics": {"include": ["malnutrition", "nutrition\\w*", "dietit\\w*", "enteral", "parenteral", "tube[- ]fe(?:d|eding)", "vitamin \\w+", "B12 deficiency"]},
    "obesity-and-weight-management": {"include": ["obesity", "obese", "weight[- ]loss", "weight management", "(?-i:GLP-1s?)", "semaglutide", "tirzepatide", "Mounjaro", "Wegovy", "Foundayo", "orforglipron", "bariatric"]},
    "oncology-and-sact": {"include": ["cancers?", "oncolog\\w*", "chemotherapy", "(?-i:SACT)", "tumours?", "radiotherapy", "immunotherapy", "carcinoma", "leukaemia", "lymphoma", "myeloma", "melanoma"],
      "exclude": ["(?:ambition|same|much|seriously) as cancer"]},
    "ophthalmology": {"include": ["ophthalm\\w*", "glaucoma", "cataracts?", "macular", "eye (?:care|diseases?|conditions?|tests?|clinics?|hospitals?|drops|services?)", "eyesight", "sight loss", "optometr\\w*", "retina\\w*"]},
    "orthopaedics-and-trauma": {"include": ["orthopaedic\\w*", "(?:hip|knee|joint|shoulder) replacements?", "fractures?", "osteoporosis", "musculoskeletal", "(?-i:MSK)", "osteoarthritis", "spinal surgery"]},
    "paediatrics": {"include": ["paediatric\\w*", "child(?:ren)?(?:(?:'|’)s)?", "childhood", "infants?", "babies", "newborns?", "adolescen\\w*", "school nurs\\w*"],
      "exclude": ["children(?:'|’)s records", "parents access", "no kids"]},
    "pain-management": {"include": ["chronic pain", "pain management", "pain relief", "opioids?", "analgesi\\w*", "painkillers?", "gabapentinoids?", "pregabalin", "fibromyalgia", "back pain"]},
    "palliative-and-end-of-life-care": {"include": ["palliative", "end[- ]of[- ]life", "hospices?", "assisted dying"]},
    "pathology-and-laboratory-medicine": {"include": ["patholog\\w*", "laborator(?:y|ies)", "phlebotomy", "routine blood tests?", "samples (?:unusable|lost|delayed|rejected)", "point-of-care", "Synnovis"]},
    "patient-handling": {"include": ["hoists?", "slings?", "moving and handling", "manual handling", "patient handling", "slide sheets?", "transfer aids?", "profiling beds?"]},
    "pharmacy-and-medicines": {"include": ["pharmac(?:y|ies|ist|ists)", "Pharmacy First", "out of stock", "discontinu\\w*", "(?:medicine|medicines|drug|tablet|supply) shortages?", "shortage expected", "formular(?:y|ies)", "medicines? waste", "hazardous medicin\\w*"]},
    "plastics-burns-and-reconstruction": {"include": ["plastic surgery", "burns (?:units?|injur\\w*|care|services?|centres?|patients)", "burn injur\\w*", "reconstructive", "cosmetic (?:surgery|procedures?)", "breast implants?", "scarring"]},
    "primary-care-and-general-practice": {"include": ["primary care", "general practice", "(?-i:GPs?)", "practice nurs\\w*", "(?-i:GPN)s?"]},
    "radiology-and-imaging": {"include": ["radiolog\\w*", "radiograph\\w*", "imaging", "(?-i:MRI)", "(?-i:CT) scans?", "X-rays?", "ultrasound", "mammogra\\w*", "scanners?", "community diagnostic centres?"]},
    "rehabilitation-prosthetics-and-orthotics": {"include": ["rehabilitation", "rehab", "prosthe\\w*", "orthotic\\w*", "physiotherap\\w*", "occupational therap\\w*", "wheelchairs?", "mobility aids?", "reablement", "amputees?"]},
    "renal": {"include": ["renal", "kidneys?", "dialysis", "nephrolog\\w*", "(?-i:CKD)"]},
    "respiratory": {"include": ["asthma", "(?-i:COPD)", "inhalers?", "respiratory", "lungs?", "pneumonia", "bronchiolitis", "(?-i:RSV)", "breathing problems"]},
    "sepsis-and-the-deteriorating-patient": {"include": ["sepsis", "septic", "deteriorating patients?", "(?-i:NEWS2)", "early warning scores?", "Martha(?:'|’)s rule"]},
    "stroke": {"include": ["strokes?", "thrombectomy", "(?-i:TIA)", "transient ischaemic attack"],
      "exclude": ["heat ?stroke", "stroke of"]},
    "theatres-and-surgical": {"include": ["operating theatres?", "theatres", "surgical", "surgery waiting", "elective (?:surgery|care|recovery)", "anaesthe\\w*", "perioperative"],
      "exclude": ["GP surgery", "super GP surgery", "surgery (?:shuts|closes|closure)"]},
    "tissue-viability-and-wound-care": {"include": ["wounds?", "wound care", "pressure ulcers?", "leg ulcers?", "tissue viability", "diabetic foot", "dressings"]},
    "urology": {"include": ["urolog\\w*", "prostate", "(?-i:PSA) test\\w*", "bladder cancer", "bladder damage", "kidney stones?", "erectile dysfunction", "haematuria", "lower urinary tract symptoms", "(?-i:LUTS)"]},
    "vascular-access-and-iv-therapy": {"include": ["cannula\\w*", "(?-i:PICCs?)", "central (?:venous|line)\\w*", "intravenous", "(?-i:IV) (?:therapy|administration|lines?)", "infusions?", "flushing"]},
    "vascular-surgery-and-pad": {"include": ["peripheral arterial disease", "(?-i:PAD)", "aneurysms?", "varicose", "amputations?", "diabetic foot", "vascular surgery"]}
  }
}
