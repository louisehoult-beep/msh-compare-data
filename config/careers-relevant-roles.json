{
 "_about": "Which supplier job listings the Hub's Career Centre (page 679) shows. Lou's ruling, in chat 28/09/2026: 'there is no max, they just need to be in the right categories or job titles'. No maximum number of roles and no minimum supplier base. A UK role from data/supplier-careers.json is shown when its job title matches one of the categories below and none of the exclude patterns. Read by scripts/careers_relevance.py (tested by test_careers_relevance.py) and by app/careers-roles.js on the page, so this file is the one place the list lives. Edit it here; the page picks the change up on its next load.",
 "match": "Each pattern is a case-insensitive regular expression tested against the job title as the company published it. Keep patterns to plain words, \\b, alternation and optional groups, so Python and the browser read them identically. Exclude is checked first and vetoes. Categories are then tried in the order listed; the first that matches names the role's category.",
 "exclude": [
  "\\btalent acquisition\\b",
  "\\brecruit(er|ers|ment|ing)?\\b",
  "\\bhr\\b",
  "\\bhuman resources\\b",
  "\\bpayroll\\b",
  "\\baccountants?\\b",
  "\\bfinance\\b",
  "\\bfinancial\\b",
  "\\btax\\b",
  "\\baudit(or|ors)?\\b",
  "\\bmanufactur",
  "\\bproduction\\b",
  "\\bwarehouse\\b",
  "\\blogistics\\b",
  "\\bsupply chain\\b",
  "\\bmaintenance\\b",
  "\\bsoftware\\b",
  "\\bdevelopers?\\b",
  "\\bit (support|analyst|manager|engineer|technician)\\b",
  "\\blaboratory\\b",
  "\\blab\\b",
  "\\br&d\\b",
  "\\bresearch (and|&) development\\b",
  "\\bquality (assurance|control|engineer|manager|specialist)\\b",
  "\\bregulatory\\b",
  "\\bbuyer\\b",
  "\\bcustomer service\\b",
  "\\badministrator\\b",
  "\\badmin assistant\\b"
 ],
 "categories": [
  {"key": "key-account", "label": "Key account manager",
   "patterns": ["\\bkey account\\b", "\\bkam\\b",
                "\\b(strategic|national) accounts? (manager|director|lead)\\b"]},
  {"key": "clinical-product-specialist", "label": "Clinical, application and product specialist",
   "patterns": ["\\bclinical (sales |account )?specialists?\\b",
                "\\bclinical applications?\\b",
                "\\bapplications? (specialists?|scientists?|engineers?)\\b",
                "\\bproduct specialists?\\b"]},
  {"key": "sales-specialist", "label": "Sales specialist",
   "patterns": ["\\bsales specialists?\\b", "\\bspecialist sales\\b"]},
  {"key": "business-development", "label": "Business development",
   "patterns": ["\\bbusiness development\\b", "\\bbdm\\b", "\\bnew business\\b"]},
  {"key": "market-access", "label": "Market access",
   "patterns": ["\\bmarket access\\b", "\\bvalue (and|&) access\\b", "\\breimbursement\\b"]},
  {"key": "tenders-bids", "label": "Tenders, bids and contracts",
   "patterns": ["\\btenders?\\b", "\\bbids?\\b",
                "\\bcontracts? (manager|lead|specialist|executive)\\b"]},
  {"key": "customer-success-clinical-support", "label": "Customer success and clinical support",
   "patterns": ["\\bcustomer success\\b",
                "\\bclinical support\\b",
                "\\bclinical educators?\\b",
                "\\bclinical (nurse )?advis(e|o)rs?\\b",
                "\\bclinical trainers?\\b"]},
  {"key": "territory-account", "label": "Territory and account manager",
   "patterns": ["\\bterritory\\b", "\\barea sales (manager|executive)\\b",
                "\\baccount managers?\\b"]},
  {"key": "sales-management", "label": "Sales manager and director",
   "patterns": ["\\bsales (manager|director|lead|leader)s?\\b",
                "\\bhead of (sales|commercial)\\b",
                "\\bcommercial (manager|director|lead)s?\\b",
                "\\b(vp|vice president),? (of )?sales\\b"]},
  {"key": "sales-rep", "label": "Sales representative and executive",
   "patterns": ["\\bsales (representative|rep|executive|consultant|associate|engineer)s?\\b",
                "\\bmedical (sales )?representatives?\\b",
                "\\baccount executives?\\b",
                "\\bfield sales\\b", "\\binside sales\\b"]}
 ]
}
